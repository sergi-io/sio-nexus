{
  "name": "sio-nexus",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "bun run --watch src/main.ts run --market-scanner",
    "dashboard": "bun run src/main.ts run --dashboard",
    "market-scanner-dashboard": "bun run src/main.ts market-scanner-dashboard",
    "start": "bun run dist/main.js",
    "clean": "rimraf ./build ./logs",
    "clean:all": "bun run clean",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src --max-warnings=0",
    "upgrade-packages-interactive": "bunx npm-check-updates -ui",
    "build": "bun build --compile --minify --minify-whitespace --minify-syntax --target=bun-linux-x64 --bytecode --root src --outfile build/x64/sio-nexus ./src/main.ts ./src/nexus/ExchangeWorker.ts ./src/nexus/marketScanner/MarketScannerWorker.ts",
    "download-historical-data": "bun run src/main.ts download-historical-data",
    "import-historical-klines": "bun run src/main.ts import-historical-klines",
    "analyze-kline-gaps": "bun run src/utils/db/klines/analyzeKlineGaps.ts",
    "repair-kline-gaps": "bun run src/utils/db/klines/repairKlineGaps.ts",
    "deploy": "sh scripts/deploy.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "ansis": "4.2.0",
    "blessed": "0.1.81",
    "ccxt": "4.5.52",
    "commander": "14.0.3",
    "csv-parse": "6.2.1",
    "csv-stringify": "6.7.0",
    "lodash": "4.18.1",
    "nanoid": "5.1.11",
    "ora": "9.4.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "protobufjs": "^8.0.3",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.3.13",
    "@types/blessed": "0.1.27",
    "@types/eslint__js": "9.14.0",
    "@types/lodash": "4.17.24",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "typescript-eslint": "8.59.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --cache --max-warnings=0"
    ]
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true
}
