#################################################################
# GENERAL CONFIG
#################################################################
# Env could be dev / prod / test.
SIO_NEXUS_PROJECT_NAME=SIO_NEXUS
SIO_NEXUS_ENV=dev
SIO_NEXUS_SHOW_INIT_BANNER=true
SIO_NEXUS_SSH_PORT=XXXXX
SIO_NEXUS_SSH_USERNAME=XXXXX
SIO_NEXUS_SSH_HOST=XXXXX
#################################################################
# LOGGER
#################################################################
SIO_NEXUS_LOG_DIR=./logs
SIO_NEXUS_WRITE_LOG_TO_FILES=false
SIO_NEXUS_LOG_ENABLED=true
# LOG Levels from TOP to BOTTOM ------>----->------>------>----->------>
# Values for SIO_NEXUS_LOG_LEVEL: fatal, error, warn, info, debug, trace
# Take into account that the logger will always log the messages with level "warn" and above
# Note: all successful HTTP requests are logged with level "trace"
# If you want to see all the logs, you should set the level to "trace"
# Recommended value for production: info
# Recommended value for development: debug or trace
SIO_NEXUS_LOG_LEVEL=debug
#################################################################
# UNIX SOCKET
#################################################################
SIO_NEXUS_AGGR_SOCKET_PATH=/tmp/sio-nexus-aggr.sock
SIO_NEXUS_QUERY_SOCKET_PATH=/tmp/sio-nexus-query.sock
SIO_NEXUS_SCANNER_SOCKET_PATH=/tmp/sio-nexus-scanner.sock
#################################################################
